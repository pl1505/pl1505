-- 1. Создание таблицы Грузовиков (Trucks)
CREATE TABLE Trucks (
    TruckID INT PRIMARY KEY IDENTITY(1,1), -- Первичный ключ, автоинкремент
    Model NVARCHAR(255) NOT NULL,
    LicensePlate NVARCHAR(20) NOT NULL UNIQUE -- Номерной знак уникален
);
GO

-- 2. Создание таблицы Заказов (Orders)
CREATE TABLE Orders (
    OrderID INT PRIMARY KEY IDENTITY(1,1), -- Первичный ключ, автоинкремент
    ClientName NVARCHAR(255) NOT NULL,
    OrderNumber NVARCHAR(50) NOT NULL,
    DeparturePoint NVARCHAR(100),
    DeliveryPoint NVARCHAR(100),
    DeliveryDate DATE,
    PaymentDate DATE,
    OrderSum DECIMAL(18, 2),

    -- Внешний ключ для связи с таблицей Trucks
    TruckID INT NULL, -- NULL означает, что грузовик еще не назначен

    -- Определение внешнего ключа
    -- FK_Orders_Trucks - это имя ограничения внешнего ключа
    CONSTRAINT FK_Orders_Trucks
        FOREIGN KEY (TruckID) -- Столбец в таблице Orders, который будет внешним ключом
        REFERENCES Trucks(TruckID) -- Ссылка на столбец TruckID в таблице Trucks
        ON DELETE SET NULL -- Если грузовик будет удален, TruckID в заказе станет NULL
        ON UPDATE CASCADE -- Если TruckID в Trucks изменится, он обновится и здесь
);
